{
  "name": "locale-lint",
  "version": "0.1.0",
  "description": "Fast CI linter for i18n locale coverage and hardcoded strings",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "locale-lint": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --external:jsonc-parser --external:@vue/compiler-sfc --external:fluent-vue-cli --alias:@babel/traverse=./src/engine/babel-traverse-shim.ts --outfile=dist/cli.cjs --banner:js='#!/usr/bin/env node'",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vendor:sync": "tsx scripts/vendor-sync.ts",
    "vendor:check": "tsx scripts/vendor-sync.ts --check",
    "shim:surface": "tsx scripts/shim-surface.ts",
    "golden:freeze": "npm run build && tsx scripts/freeze-golden.ts",
    "golden:check": "npm run build && tsx scripts/freeze-golden.ts --check"
  },
  "dependencies": {
    "@antfu/utils": "^0.7.10",
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "bcp-47": "^2.1.1",
    "blueimp-md5": "^2.19.0",
    "fast-glob": "^3.3.2",
    "fluent-vue-cli": "^3.0.4",
    "fs-extra": "^11.2.0",
    "glob-gitignore": "^1.0.14",
    "htmlparser2": "^9.1.0",
    "iconv-lite": "^0.6.3",
    "ini": "^2.0.0",
    "js-yaml": "^4.1.0",
    "json-source-map": "^0.6.1",
    "json-stable-stringify": "^1.1.1",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.17.21",
    "micromatch": "^4.0.8",
    "parse-gitignore": "^2.0.0",
    "php-array-parser": "^1.0.1",
    "pofile": "^1.1.1",
    "properties": "^1.2.1",
    "smol-toml": "^1.3.1",
    "string-similarity": "^4.0.4",
    "yaml": "^1.10.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/blueimp-md5": "^2.18.2",
    "@types/fs-extra": "^11.0.4",
    "@types/ini": "^1.3.34",
    "@types/js-yaml": "^4.0.9",
    "@types/json-stable-stringify": "^1.0.36",
    "@types/lodash": "^4.17.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^20.16.5",
    "@types/string-similarity": "^4.0.2",
    "esbuild": "^0.24.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
